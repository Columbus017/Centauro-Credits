# Production environment for `docker-compose.yml`.
#
# These are the values Dokploy holds in its **Environment** tab. Nothing here
# is a working secret and nothing here is committed with one — every entry is a
# placeholder, and `docker-compose.yml` refuses to start if any is missing.
#
# The secrets in the legacy `docker-compose.yml` were committed in plaintext
# and are in the repository history. **Rotate all of them.** Do not carry the
# MySQL root password, the application password or the phpMyAdmin credentials
# into this stack; the migrated database gets new ones.
#
# Locally: `cp .env.production.example .env.production` and
# `docker compose --env-file .env.production up -d --build`.

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=centauro
POSTGRES_USER=centauro

# `openssl rand -hex 32`. Hex on purpose: this password is also embedded in
# DATABASE_URL below, where `@`, `:`, `/` and `#` would have to be
# percent-encoded and one day would not be.
POSTGRES_PASSWORD=replace-me-openssl-rand-hex-32

# --- Application ------------------------------------------------------------

# `postgres` is the compose service name, and 5432 is the container's own port
# — not the 5433 the development compose publishes on the host. The three
# values must match the block above.
DATABASE_URL=postgresql://centauro:replace-me-openssl-rand-hex-32@postgres:5432/centauro?schema=public

# Signs the Auth.js session cookie: `openssl rand -base64 32`, or
# `pnpm dlx auth secret`. Per environment, never shared with staging, and
# rotating it signs every operator out.
AUTH_SECRET=replace-me-openssl-rand-base64-32

# --- One-shot MySQL import (scripts/migrate-from-mysql.ts) ------------------
#
# Both of these are commented out on purpose: they are set for the length of
# the migration and removed again afterwards. Nothing in a normal deploy reads
# them, and `docker-compose.yml` does not require them.
#
# `mysql-legacy` is the `etl`-profile MySQL 5.7 in `docker-compose.yml` — a
# scratch container on the internal network, into which the dump is restored on
# *this* host. The ETL only ever reads, and it must only ever be pointed at a
# restored copy, never at the live legacy database.
#
# `localdb` is the database name the dump creates for itself; 3306 is the
# container's own port, and nothing publishes it.
# MYSQL_URL=mysql://root:legacy-etl-scratch@mysql-legacy:3306/localdb

# The scratch container's root password. It defaults to `legacy-etl-scratch`
# in the compose file — acceptable only because that container has no published
# port, lives on the internal network, and is destroyed at the end of the
# cutover. Set it to something else if you prefer, and keep it and MYSQL_URL in
# agreement.
# LEGACY_MYSQL_PASSWORD=legacy-etl-scratch
