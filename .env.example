# Copy to `.env`. Matches docker-compose.dev.yml; production values live in the
# hosting provider's dashboard and are never committed.
DATABASE_URL="postgresql://centauro:centauro@localhost:5433/centauro?schema=public"

# Only for a managed Postgres, which offers two URLs for the same database: a
# pooled one (what the deployed app uses, above) and a direct one. Migrations,
# the seed and the ETL need the direct one — a pooled connection cannot hold a
# transaction open across statements, and those three do. Locally there is one
# database and one URL, so leave this unset.
# DIRECT_DATABASE_URL="postgresql://…@…neon.tech/centauro?sslmode=require"

# Signs the Auth.js session cookie. Generate one per environment with
# `pnpm dlx auth secret`, or `openssl rand -base64 32`. Rotating it signs
# everyone out; it is never committed.
AUTH_SECRET="dev-only-secret-replace-me-with-openssl-rand-base64-32"

# Source for the one-shot ETL (scripts/migrate-from-mysql.ts). Point this at a
# restored *copy* of a mysqldump, never at the live database.
MYSQL_URL="mysql://root:etl@localhost:3307/localdb"
