# Copy to `.env`. Matches docker-compose.dev.yml; production values come from
# Dokploy env vars and are never committed.
DATABASE_URL="postgresql://centauro:centauro@localhost:5433/centauro?schema=public"

# Source for the one-shot ETL (scripts/migrate-from-mysql.ts). Point this at a
# restored *copy* of a mysqldump, never at the live database.
MYSQL_URL="mysql://root:etl@localhost:3307/localdb"
